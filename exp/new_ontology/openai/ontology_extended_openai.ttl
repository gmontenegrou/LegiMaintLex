    rdfs:range semleg:Situation ;
    semlegm:confidenceValue 0.91 ;
    semlegm:textualEvidenceCount 1 .

semlegm:appliesTo a owl:ObjectProperty ;
    rdfs:comment "Indicates that an action is applicable to a specific artifact."^^xsd:string,
        "Indicates the action to which a condition is applicable."^^xsd:string,
        "Relates a legal source to the action(s) to which it is applicable."^^xsd:string,
        "Relates a situation to the artifact to which it is relevant or applicable."^^xsd:string,
        "Relates an artifact (such as a device or system) to a location where it is applicable or in use."^^xsd:string,
        "Relates an artifact (such as a permit or authorization) to an action to which it applies or is required."^^xsd:string,
        "Relates an artifact (such as an authorization) to another artifact (such as a component or part) to which it applies."^^xsd:string ;
    rdfs:domain semleg:Action,
        semleg:Artifact,
        semleg:Condition,
        semleg:Situation,
        semleg:Source ;
    rdfs:range semleg:Action,
        semleg:Artifact,
        semleg:Location ;
    semlegm:confidenceValue 0.85,
        0.89,
        0.9,
        0.91,
        0.93,
        0.95 ;
    semlegm:textualEvidenceCount 1,
        2 .

semlegm:appliesToActor a owl:ObjectProperty ;
    rdfs:comment "Relates a legal source to the actor(s) to which it is applicable."^^xsd:string,
        "Relates an action to the actor it is directed at or involves as a subject."^^xsd:string ;
    rdfs:domain semleg:Action,
        semleg:Source ;
    rdfs:range semleg:Actor ;
    semlegm:confidenceValue 0.85,
        0.88 ;
    semlegm:textualEvidenceCount 1,
        2 .

semlegm:appliesToArtifact a owl:ObjectProperty ;
